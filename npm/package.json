    "postinstall": "node dist/bin/postinstall.js || true"
  },
  "engines": {
    "node": ">=18.18.0",
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "execa": "^9.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3"
  }
}
