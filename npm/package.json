{
  "name": "@netpiedev/drift",
  "version": "0.1.5",
  "description": "Drift migration CLI wrapper for Node.js and Bun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/netpiedev/drift"
  },
  "bugs": {
    "url": "https://github.com/netpiedev/drift/issues"
  },
  "homepage": "https://github.com/netpiedev/drift#readme",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "drift": "dist/bin/drift.js"
  },
  "main": "dist/bin/drift.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
